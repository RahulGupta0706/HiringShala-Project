# Copy this file to .env for local development.
# NEVER commit .env to version control.
# For Vercel: REACT_APP_API_URL is not needed (API is on same domain).
#             Set REACT_APP_GOOGLE_CLIENT_ID in the Vercel project dashboard.

# Backend API base URL (no trailing slash).
# Leave empty or unset in production — API calls will use relative paths.
# Development: http://localhost:8000
REACT_APP_API_URL=http://localhost:8000

# Google OAuth 2.0 Client ID
# Create/find at: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=
