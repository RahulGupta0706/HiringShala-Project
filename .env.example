# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# For Vercel: add these as Environment Variables in the Vercel project dashboard
#             (Settings → Environment Variables).

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# MongoDB Atlas connection string
# Create a cluster at https://cloud.mongodb.com, then:
#   Database Access → Add user → copy connection string and replace <password>
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hiringshala?retryWrites=true&w=majority

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── AWS ──────────────────────────────────────────────────────────────────────
# IAM user needs: s3:PutObject on the bucket + ses:SendEmail
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# S3 bucket for resume uploads
S3_BUCKET_NAME=

# SES verified sender address
SES_SOURCE_EMAIL=
